rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function eventDoc(eventoId) {
      return get(/databases/$(database)/documents/events/$(eventoId));
    }

    function isEventCreator(eventoId) {
      return isSignedIn() && (
        eventDoc(eventoId).data.creadorId == request.auth.uid ||
        eventDoc(eventoId).data.creadorId == '' ||
        (exists(/databases/$(database)/documents/usernames/$(eventDoc(eventoId).data.creadorId))
          && get(/databases/$(database)/documents/usernames/$(eventDoc(eventoId).data.creadorId)).data.uid == request.auth.uid)
      );
    }

    // usernames: Garantiza unicidad y permite lookup en login
    // get puntual permitido sin auth (para login con usuario).
    // list bloqueado para evitar enumeración.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() 
        && request.resource.data.uid == request.auth.uid 
        && request.resource.data.correo is string;
      allow update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && resource.data.correo == request.resource.data.correo;
      allow delete: if false;
    }

    // users: Perfiles de usuario
    match /users/{uid} {
      // Lectura autenticada (necesaria para ver datos públicos de organizadores)
      allow get: if isSignedIn();
      allow list: if false;
      
      // Creación al registrarse
      allow create: if isOwner(uid)
        && request.resource.data.usuario is string
        && request.resource.data.correo is string
        && request.resource.data.nombre.size() >= 3;

      // Actualización solo por el dueño
      // Dado que el pago es simulado en cliente (sin Cloud Functions en plan Spark),
      // el usuario puede actualizar sus datos y marcar planPro si adquirió la suscripción.
      allow update: if isOwner(uid)
        && request.resource.data.usuario == resource.data.usuario; // el username no se puede cambiar de id

      allow delete: if false;

      // Subcolección favoritos
      match /favoritos/{eventoId} {
        allow read, write: if isOwner(uid);
      }

      // Subcolección notificaciones
      match /notificaciones/{notifId} {
        allow read, delete: if isOwner(uid);
        
        // El dueño solo puede actualizar el estado de lectura
        allow update: if isOwner(uid) 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);

        // Cualquier usuario autenticado puede generar una notificación a otro usuario
        // (por ejemplo: confirmación de inscripción, evento reprogramado, etc.)
        // con campos y tamaños estrictamente validados.
        allow create: if isSignedIn()
          && request.resource.data.keys().hasAll(['titulo', 'descripcion', 'tipo', 'leida', 'pideCalificacion', 'idEvento'])
          && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 100
          && request.resource.data.descripcion is string && request.resource.data.descripcion.size() <= 500
          && request.resource.data.tipo in ['Eventos', 'Organizador']
          && request.resource.data.leida == false
          && request.resource.data.pideCalificacion is bool
          && request.resource.data.idEvento is string;
      }
    }

    // Collection group para consultar inscripciones
    match /{path=**}/inscripciones/{inscripcionId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.uid ||
        request.auth.uid == inscripcionId ||
        resource.data.creadorId == request.auth.uid ||
        isEventCreator(resource.data.eventoId)
      );
    }

    // events: Eventos
    match /events/{eventoId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() 
        && (
          request.resource.data.creadorId == request.auth.uid || 
          request.resource.data.creadorId == '' ||
          (exists(/databases/$(database)/documents/usernames/$(request.resource.data.creadorId))
            && get(/databases/$(database)/documents/usernames/$(request.resource.data.creadorId)).data.uid == request.auth.uid)
        )
        && request.resource.data.cuposTotales >= 0
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && (!('ubicacion' in request.resource.data) || request.resource.data.ubicacion is latlng);

      allow delete: if isSignedIn() && resource.data.creadorId == request.auth.uid;

      allow update: if isSignedIn() && (
        // Caso A: El creador del evento puede actualizar todos sus campos
        (
          resource.data.creadorId == request.auth.uid
          && (!('ubicacion' in request.resource.data) || request.resource.data.ubicacion is latlng)
        )
        ||
        // Caso B: Excepción controlada para asistentes/visitantes:
        // Solo pueden modificar cuposDisponibles, visualizaciones, ratingSuma y ratingCantidad
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cuposDisponibles', 'visualizaciones', 'ratingSuma', 'ratingCantidad'])
          && request.resource.data.cuposDisponibles >= 0 
          && request.resource.data.cuposDisponibles <= resource.data.cuposTotales
          && (request.resource.data.visualizaciones == resource.data.visualizaciones + 1 
              || request.resource.data.visualizaciones == resource.data.visualizaciones)
          && request.resource.data.creadorId == resource.data.creadorId
          && request.resource.data.cuposTotales == resource.data.cuposTotales
        )
      );

      // Subcolección de imágenes de alta resolución (Plan B para tamaño de documentos < 1MB)
      match /imagenes/{tipo} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      // Subcolección inscripciones: cada documento es una entrada individual con ID automático
      match /inscripciones/{inscripcionId} {
        allow read: if isSignedIn() && (
          request.auth.uid == resource.data.uid ||
          request.auth.uid == inscripcionId ||
          isEventCreator(eventoId)
        );

        // Creación: solo a nombre propio, con estado Activa, código seguro y antes de fechaFin
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.eventoId == eventoId
          && request.resource.data.estado in ['Activa', 'activa']
          && request.resource.data.codigo is string
          && request.resource.data.codigo.size() >= 16
          && (!('fechaFin' in eventDoc(eventoId).data) || request.time < eventDoc(eventoId).data.fechaFin);

        // Modificación de entrada:
        // 1. El asistente dueño solo puede anular su entrada activa (estado -> 'Anulada')
        // 2. El organizador del evento solo puede hacer check-in (estado -> 'Asistio' y checkInEn)
        allow update: if isSignedIn() && (
          (
            (request.auth.uid == resource.data.uid || request.auth.uid == inscripcionId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
            && resource.data.estado in ['Activa', 'activa']
            && request.resource.data.estado == 'Anulada'
          )
          ||
          (
            isEventCreator(eventoId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'checkInEn'])
            && resource.data.estado in ['Activa', 'activa']
            && request.resource.data.estado == 'Asistio'
          )
        );

        allow delete: if false;
      }

      // Subcolección calificaciones
      match /calificaciones/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid) 
          && request.resource.data.estrellas >= 1 
          && request.resource.data.estrellas <= 5;
      }
    }
  }
}
